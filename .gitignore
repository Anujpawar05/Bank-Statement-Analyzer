# ==========================================
# Bank Statements, Documents & Exports (Confidential / Sensitive)
# ==========================================
# Exclude all PDFs, Excels, CSVs anywhere in the repository
*.pdf
*.PDF
*.xlsx
*.XLSX
*.xls
*.XLS
*.csv
*.CSV

# Keep folders tracked via .gitkeep but ignore all user / statement data
sample_data/*
!sample_data/.gitkeep

uploads/*
!uploads/.gitkeep

outputs/*
!outputs/.gitkeep

temp/*
!temp/.gitkeep

logs/*
!logs/.gitkeep

# Local directory and structure dumps
structure.txt
project_structure.txt
*.log

# ==========================================
# Python & Virtual Environment
# ==========================================
__pycache__/
*.py[cod]
*.pyc
venv/
.venv/
env/
ENV/
build/
dist/
*.egg-info/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Secrets & Environment Variables
.env
.env.*
*.key
*.pem

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# OCR Models & Cache
.paddleocr/
.paddlex/